# Configure these as server-only secrets in your hosting environment.
# Never commit real values.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Optional: exact external callback URL if a reverse proxy changes req.url.
TWILIO_WEBHOOK_URL=

# Self-hosted gateway only (Ansible generates the session secret)
APP_ORIGIN=https://kakakin.africandroid.world
BOOTSTRAP_ADMIN_EMAIL=
SESSION_SECRET=
ACCOUNTS_FILE=/config/accounts.json
DATA_DIR=/data
PORT=18770
